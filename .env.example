# Anthropic API key (required) — get yours at https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=your-api-key-here

# Base URL (optional) — override to use a proxy or local mock server
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# API version (optional) — override the default API version header
# ANTHROPIC_API_VERSION=2023-06-01

# Request timeout in seconds (optional) — default is 600
# ANTHROPIC_TIMEOUT=600
